{
  "name": "condobot",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente de WhatsApp para moradores do Condomínio Atlantis Park",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "check:meta": "tsx --env-file-if-exists=.env scripts/check-meta.ts",
    "chat": "tsx --env-file-if-exists=.env scripts/chat.ts"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
