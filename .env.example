# Chave da API do Gemini (Google AI Studio)
GEMINI_API_KEY=
# Modelo (padrão: gemini-3.5-flash-lite, o único com cota diária útil no plano gratuito)
GEMINI_MODEL=gemini-3.5-flash-lite
# Raciocínio nos modelos 3.x: MINIMAL, LOW, MEDIUM ou HIGH. LOW errou menos que MINIMAL na avaliação
GEMINI_THINKING_LEVEL=LOW

# WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp > Configuração da API)
ACCESS_TOKEN=
PHONE_NUMBER_ID=
# Texto livre que você define e repete no painel da Meta ao cadastrar o webhook
VERIFY_TOKEN=
# Chave secreta do app (Configurações > Básico). Se preenchida, o servidor valida a assinatura de cada chamada da Meta
APP_SECRET=

# Seu número, com DDI e DDD (ex.: 5521999999999)
SUPER_ADMIN_PHONE=
# Números que podem mudar o status das áreas pelo WhatsApp (#manutencao, #fechar, #abrir), separados por vírgula
SINDICO_PHONES=
# Durante o piloto, o bot só responde a estes números (separados por vírgula). Vazio = responde a todos
ALLOWED_PHONES=

# Acima desse número de cadastrados no apto, pedidos de família vão para a administração
MAX_MORADORES_POR_APTO=6
# Pasta do banco SQLite (status das áreas). Em produção, um volume persistente
DATA_DIR=data

PORT=3000
